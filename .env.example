# 环境变量模板。复制成 .env.local 供本地 vercel dev 使用；
# 生产环境必须在 Vercel 控制台 → Settings → Environment Variables 里逐项设置。
# .env.local 绝不提交到 Git、绝不写进前端代码。

# 必填：签发解锁 token 的 HMAC 密钥，换成自己的随机长字符串
UNLOCK_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# 收款平台：mbd = 面包多，afdian = 爱发电
PAY_PROVIDER=mbd

# 解锁最低实付金额（元），与商品定价一致
MIN_AMOUNT=19.9

# 面包多开发者 Key：编辑资料 → 开发设置 → 开发者key，原样填入，只在服务端使用
MBD_DEV_KEY=REPLACE_WITH_YOUR_DEVELOPER_KEY

# 可选：只认本作品的订单（填商品链接末尾那段 urlkey，例如 YZ2amZk=）
# MBD_PRODUCT_URLKEY=
# 可选：允许「全家桶购买」(orderamount = 0) 的订单解锁
# ALLOW_BUNDLE=1
# 可选：订单接口地址，默认官方 https://x.mbd.pub/api/order-detail
# MBD_ORDER_API=https://x.mbd.pub/api/order-detail
# 可选：平台自动发货的卡密，逗号分隔（不配也能用订单号核验）
# UNLOCK_CODES=

# 以下仅在使用爱发电（PAY_PROVIDER=afdian）时需要
# AFDIAN_USER_ID=
# AFDIAN_TOKEN=
# AFDIAN_PLAN_ID=
